# Copy or source these values on the publishing host. Keep private-key.pem out
# of this file and out of version control.

PUBLISHER_INTERVAL_MS=21600000
PUBLISHER_RUN_ON_START=1
PUBLISHER_MIN_MODELS=1
PUBLISHER_MAX_MODEL_DROP_PERCENT=50

# The default exporter writes JSON to stdout when this path is set.
PUBLISHER_DB_PATH=/path/to/freeapi.db

# Discover models, sync custom endpoints, probe availability, and update the
# router database before exporting the catalog.
PUBLISHER_PREPARE_COMMAND=./fork/catalog/scripts/prepare-from-db.sh

# Discovery scope: existing, all, none, or a comma-separated platform list.
PREPARE_DISCOVERY_PLATFORMS=existing
PREPARE_SYNC_CUSTOM=1
PREPARE_PROBE_LIMIT=20
PREPARE_DISABLE_INVALID_DISCOVERED=1

# Always validate the exported catalog before signing.
PUBLISHER_VALIDATE_COMMAND=node fork/catalog/src/validate-catalog.mjs

# Optional override for a completely custom exporter.
# PUBLISHER_EXPORT_COMMAND=npm run export-catalog -w server -- --stdout --tier live
