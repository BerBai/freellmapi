# Fork-only example. Copy the relevant values into .env; never commit .env.
#
# Serve a signed catalog at this base URL. The router requests:
#   GET <CATALOG_BASE_URL>/v1/latest[?since=<version>]
CATALOG_BASE_URL=https://catalog.example.com

# Ed25519 public key matching the private key used by the catalog server.
# Keep the literal \n escapes when the value is stored on one .env line.
CATALOG_PUBKEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_YOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----

# Emergency kill switch. Leave disabled for normal operation.
# CATALOG_SYNC_DISABLED=0
